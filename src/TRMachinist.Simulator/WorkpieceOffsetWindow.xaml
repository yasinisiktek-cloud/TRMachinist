<Window x:Class="TRMachinist.Simulator.WorkpieceOffsetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parça / CSYS Konum Düzeltmesi" Width="600" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBackground}" Foreground="{StaticResource ForegroundPrimary}" FontFamily="Segoe UI">
    <Grid Margin="18" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Parça konumu" />
        <TextBlock Grid.Row="1" Margin="0,7,0,13" Foreground="#93A7B6" TextWrapping="Wrap"
                   Text="Değerler seçilen machineMountCsys → PART_MOUNT_JCT eksenlerinde milimetredir. Parça, blank, fikstür, IPW ve NC çalışma çerçevesi birlikte taşınır; kinematik bağ kopmaz." />
        <Grid Grid.Row="2" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" /><ColumnDefinition Width="120" />
                <ColumnDefinition Width="46" /><ColumnDefinition Width="120" />
                <ColumnDefinition Width="46" /><ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="X" />
            <TextBox x:Name="OffsetXTextBox" AutomationProperties.Name="X konum düzeltmesi (mm)" Grid.Column="1" Padding="7" Background="#0B1218" Foreground="#EAF2F7" BorderBrush="#29A3D9" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="Y" />
            <TextBox x:Name="OffsetYTextBox" AutomationProperties.Name="Y konum düzeltmesi (mm)" Grid.Column="3" Padding="7" Background="#0B1218" Foreground="#EAF2F7" BorderBrush="#29A3D9" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="Z" />
            <TextBox x:Name="OffsetZTextBox" AutomationProperties.Name="Z konum düzeltmesi (mm)" Grid.Column="5" Padding="7" Background="#0B1218" Foreground="#EAF2F7" BorderBrush="#29A3D9" />
        </Grid>
        <Border Grid.Row="3" Margin="0,18,0,8" Padding="14" CornerRadius="8" Background="#292B2F" BorderBrush="#243240" BorderThickness="1">
            <StackPanel>
                <TextBlock Foreground="#FFD166" FontWeight="SemiBold" Text="Örnek" />
                <TextBlock Margin="0,4,0,0" Foreground="#D1D4DB" TextWrapping="Wrap"
                           Text="Alt fikstür modelde yoksa Z = +50 mm girerek tüm iş kurulumunu 50 mm yükseltebilirsiniz. Yanlış ortalanmış bir CSYS için X/Y değerleriyle düzeltme yapabilirsiniz." />
                <TextBlock Margin="0,8,0,0" Foreground="#FF8A65" TextWrapping="Wrap"
                           Text="Uygulama NC'yi yeni çerçeveyle baştan ayrıştırır ve etkin IPW testini kapatır. Kamera konumu değiştirilmez." />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Click="Zero_Click">Sıfıra dön</Button>
            <Button Click="Cancel_Click" IsCancel="True">İptal</Button>
            <Button Click="Apply_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" FontWeight="SemiBold">Uygula</Button>
        </StackPanel>
    </Grid>
</Window>
