<Window x:Class="TRMachinist.Simulator.ToolHolderLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Takım / Tutucu Kütüphanesi" Width="980" Height="650"
        MinWidth="780" MinHeight="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource WindowBackground}" Foreground="{StaticResource ForegroundPrimary}" FontFamily="Segoe UI">
    <Grid Margin="20" Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Takım ve tutucu kütüphanesi" />
            <TextBlock Margin="0,4,0,0" Foreground="#93A7B6" TextWrapping="Wrap"
                       Text="NX'ten gelen kesici ve sap ölçüleri korunur; yalnız seçtiğiniz tutucu profili ve TOOLINS bindirmesi değiştirilir. İşten gelen gerçek NX profilleri listenin başındadır." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="İşteki takımlar" Margin="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListBox x:Name="ToolList" SelectionChanged="ToolList_SelectionChanged"
                             Background="#0B1218" Foreground="#EAF2F7" BorderBrush="#243240"
                             DisplayMemberPath="Display" />
                    <TextBlock x:Name="ToolDetailsText" Grid.Row="1" Margin="3,9,3,2"
                               Foreground="#D1D4DB" FontFamily="Consolas" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#243240" />
            <GroupBox Grid.Column="2" Header="Tutucu profilleri" Margin="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="PresetGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="PresetGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tutucu" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Arayüz" Binding="{Binding Interface}" Width="80" />
                            <DataGridTextColumn Header="Boy" Binding="{Binding LengthText}" Width="72" />
                            <DataGridTextColumn Header="Ø max" Binding="{Binding DiameterText}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="PresetDetailsText" Grid.Row="1" Margin="3,9,3,2"
                               Foreground="#D1D4DB" FontFamily="Consolas" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Foreground="{StaticResource ForegroundMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                       Text="Hazır profiller simülasyon geometrisidir. Kesin üretici ölçüleri için NX iş paketindeki profili seçin." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Reset_Click" Content="NX tutucusuna dön" />
                <Button Click="Cancel_Click" IsCancel="True" Content="İptal" />
                <Button Click="Apply_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Content="Tutucuyu uygula" Margin="0,0,0,5" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
